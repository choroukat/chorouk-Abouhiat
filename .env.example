# Wach Nqder? 🇲🇦 - Environment Variables (Production & Development)

# Required: Google Gemini API key from https://aistudio.google.com
GEMINI_API_KEY="your-gemini-api-key"

# Optional: Gemini model name (default: gemini-3.8-flash or gemini-flash-latest)
GEMINI_MODEL="gemini-3.8-flash"

# Port for Express server (default: 3000)
PORT=3000

# CORS Allowed Origins (comma-separated, e.g. https://my-app.onrender.com,http://localhost:3000)
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Application Base URL
APP_URL="http://localhost:3000"
